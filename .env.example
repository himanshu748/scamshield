# Copy this template to backend/.env, not the repository root.
# Leave AWS_PROFILE unset to use the standard AWS credential chain.
# AWS_PROFILE=your-profile
BEDROCK_MODEL_ID=
# Optional external model: explicitly select openai-compatible and fill all three fields.
LLM_PROVIDER=bedrock
LLM_MODEL_ID=
LLM_BASE_URL=
LLM_API_KEY=
SCAMSHIELD_AWS_REGION=us-east-1
SCAMSHIELD_FIXTURE_MODE=true
SCAMSHIELD_LOCAL_LIVE_UI=false
SCAMSHIELD_AGENTCORE_RUNTIME_ARN=
SCAMSHIELD_DATABASE_PATH=./data/scamshield.sqlite3
